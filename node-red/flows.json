        "name": "SPARQL Construct: filter version info",
        "query": "PREFIX dct:       <http://purl.org/dc/terms/>\nPREFIX verkeer:   <https://data.vlaanderen.be/ns/verkeersmetingen#>\nPREFIX prov:      <http://www.w3.org/ns/prov#>\nPREFIX geo:       <http://www.opengis.net/ont/geosparql#>\n\nPREFIX verkeer:    <https://data.vlaanderen.be/ns/verkeersmetingen#>\nPREFIX impl:       <https://implementatie.data.vlaanderen.be/ns/vsds-verkeersmetingen#>\nPREFIX dv-netwerk: <https://data.vlaanderen.be/ns/netwerk#>\n\n\nconstruct {\n  ?s a verkeer:Verkeersmeetpunt .\n  ?s dct:isVersionOf ?v .\n  ?s dct:created ?c .\n  ?s prov:generatedAtTime ?t .\n  ?s geo:asWKT ?g .\n} where {\n  ?s a verkeer:Verkeersmeetpunt .\n  ?s dct:isVersionOf ?v .\n  ?s dct:created ?c .\n  ?s prov:generatedAtTime ?t .\n\n  ?s verkeer:bemonsterdObject / impl:Rijrichting.netwerkreferentieelement / dv-netwerk:Link.geometriemiddellijn / geo:asWKT ?g .\n}",
